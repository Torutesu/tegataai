# Security headers. The site is static and has almost no script, so the policy can be
# strict rather than a wish list.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'self' https://api.tegata.ai; frame-ancestors 'none'; img-src 'self'; media-src 'self'; style-src 'self'; script-src 'self'; connect-src https://api.tegata.ai; manifest-src 'self'

# The diagnostic must not be able to reach anything, which is the whole basis of the
# claim it makes about itself. It is enforced here, not merely stated on the page.
/tool/*
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'none'

# Fingerprinted media never changes; the pages do.
/media/*
  Cache-Control: public, max-age=31536000, immutable
/style.css
  Cache-Control: public, max-age=3600
/*.html
  Cache-Control: public, max-age=300, must-revalidate
